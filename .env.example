# Copy to `.env.local` (or `.env`) and adjust for your environment.
# Vite only exposes variables prefixed with VITE_ to the client.
# No secrets belong here: this file is compiled into the browser bundle.

# Base URL of the InsuraLens backend, including the `/api` suffix.
#
#   VITE_API_URL=https://insurance-ai-1.onrender.com/api
#
# (The legacy VITE_API_BASE_URL origin-only variable is still read as a
# fallback; if both are set, VITE_API_URL wins.)
VITE_API_URL=https://insurance-ai-1.onrender.com/api

# Trigger path: "webhook" or "backend" (empty = webhook when its URL is set,
# otherwise backend). The frontend never calls both for one run.
VITE_ANALYSIS_MODE=

# Webhook URL used by the frontend to trigger AI analysis directly (n8n).
# Set in .env.local for local development and in Vercel env vars for production.
VITE_ANALYSIS_WEBHOOK_URL=
# "POST" (default) or "GET"
VITE_ANALYSIS_WEBHOOK_METHOD=

# Chat webhook URL used by the frontend to get AI replies directly (n8n).
# Set in .env.local for local development and in Vercel env vars for production.
VITE_CHAT_WEBHOOK_URL=
