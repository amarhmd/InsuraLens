# Copy to `.env.local` (or `.env`) and fill in when the backend exists.
# Vite only exposes variables prefixed with VITE_ to the client.

# Base URL of the InsuraLens backend — origin only, no trailing slash and no
# `/api` suffix (endpoint paths in docs/API_CONTRACT.md are appended as-is).
#
#   VITE_API_BASE_URL=https://api.insuralens.example
#
# Leave empty (the default in this repo) to keep the frontend on its
# built-in mock layer: every function in src/api/ resolves data from
# src/mocks/ with a small simulated delay and never touches the network.
VITE_API_BASE_URL=
